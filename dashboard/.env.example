# Required. Powers suggestions and memory extraction/embeddings.
# Use a PAID key — free-tier rate limits degrade the live analysis loop.
GEMINI_API_KEY=your_key_here

# Optional Gemini model overrides (defaults shown).
# GEMINI_FAST_MODEL=gemini-flash-lite-latest
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# The agent is Claude Code, dispatched via the Claude Agent SDK. It needs no
# API key here — it uses the machine's Claude Code login (run `claude` once
# and sign in). Set ANTHROPIC_API_KEY only to bill an API key instead.
# CLAUDE_AGENT_MODEL=claude-opus-5   # optional; defaults to your Claude Code default model

# Optional agent browser settings.
# AGENT_BROWSER=chrome        # chrome | msedge | firefox | webkit
# AGENT_HEADLESS=1            # set to hide the browser window (default: visible)
