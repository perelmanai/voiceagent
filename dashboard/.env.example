# Required. Powers suggestions and memory extraction/embeddings.
# Use a PAID key — free-tier rate limits degrade the live analysis loop.
GEMINI_API_KEY=your_key_here

# Optional Gemini model overrides (defaults shown).
# GEMINI_FAST_MODEL=gemini-flash-lite-latest
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Actions default to Codex via the official Codex SDK, using this machine's
# Codex login (`codex login`). Optional API billing: set CODEX_API_KEY or
# OPENAI_API_KEY. Keys stay on the server; never prefix them with NEXT_PUBLIC_.
# CODEX_API_KEY=your_key_here
# CODEX_AGENT_MODEL=          # optional; otherwise uses Codex's default model
# CODEX_PATH=                # optional path to an installed Codex executable

# Claude remains selectable in the actions panel. It uses the machine's Claude
# Code login (`claude`), or ANTHROPIC_API_KEY for API billing.
# CLAUDE_AGENT_MODEL=claude-opus-5   # optional; defaults to your Claude Code default model

# Optional agent browser settings.
# AGENT_BROWSER=chrome        # chrome | msedge | firefox | webkit
# AGENT_HEADLESS=1            # set to hide the browser window (default: visible)
