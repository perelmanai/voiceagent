<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AURAL VOICE"
        android:textColor="@color/fg"
        android:textSize="16sp"
        android:letterSpacing="0.3"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Speak here — it appears on the dashboard live."
        android:textColor="@color/fg_muted"
        android:textSize="13sp" />

    <Button
        android:id="@+id/scanButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Scan QR to connect"
        android:textSize="16sp"
        android:textColor="@color/bg"
        android:backgroundTint="@color/confirm" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="— or enter manually —"
        android:textColor="@color/fg_faint"
        android:textSize="11sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Dashboard URL"
        android:textColor="@color/fg_faint"
        android:textSize="11sp"
        android:letterSpacing="0.1"
        android:textAllCaps="true" />

    <EditText
        android:id="@+id/urlField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="https://your-tunnel.ngrok-free.app"
        android:textColorHint="@color/fg_faint"
        android:textColor="@color/fg"
        android:textSize="15sp"
        android:inputType="textUri"
        android:autofillHints="url"
        android:maxLines="1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Pairing code"
        android:textColor="@color/fg_faint"
        android:textSize="11sp"
        android:letterSpacing="0.1"
        android:textAllCaps="true" />

    <EditText
        android:id="@+id/codeField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="ABCD"
        android:textColorHint="@color/fg_faint"
        android:textColor="@color/fg"
        android:textSize="22sp"
        android:letterSpacing="0.4"
        android:fontFamily="monospace"
        android:inputType="textCapCharacters"
        android:maxLength="4"
        android:maxLines="1" />

    <Button
        android:id="@+id/micButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="Start mic"
        android:textSize="16sp"
        android:textColor="@color/bg"
        android:backgroundTint="@color/accent" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Idle"
        android:textColor="@color/fg_muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/interimText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:minHeight="24dp"
        android:textColor="@color/fg_faint"
        android:textStyle="italic"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="@color/border" />

    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/fg"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.3"
            android:fontFamily="monospace" />
    </ScrollView>
</LinearLayout>
